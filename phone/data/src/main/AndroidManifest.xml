<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service
            android:name=".CommandListenerService"
            android:exported="true"
            android:permission="com.google.android.gms.permission.BIND_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />

                <data
                    android:host="*"
                    android:pathPrefix="/watchvoice/"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
